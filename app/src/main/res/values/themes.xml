<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black on white, no grey ripples, no sliding animations: kind to an e-ink screen. -->
    <style name="Eink" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#000000</item>
        <item name="android:colorPrimaryDark">#FFFFFF</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:colorControlNormal">#000000</item>
        <item name="android:colorControlActivated">#000000</item>
        <item name="android:colorControlHighlight">#00000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:textColorHint">#555555</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:alertDialogTheme">@style/EinkDialog</item>
        <item name="android:datePickerDialogTheme">@style/EinkDialog</item>
    </style>

    <style name="EinkDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#000000</item>
        <item name="android:colorControlHighlight">#00000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
